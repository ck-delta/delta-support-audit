# Copy this to .env.local and fill in real values. Never commit .env.local.

# --- LLM (OpenRouter, used for completions only) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Model slug verified at M2 — likely "anthropic/claude-sonnet-4.6"
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# --- Freshdesk (support center source) ---
FRESHDESK_DOMAIN=deltaexchange.freshdesk.com
# Profile Settings → API Key in Freshdesk
FRESHDESK_API_KEY=

# --- Upstash Redis (KV: hashes, run history, dedup) ---
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash Vector (embeddings + retrieval, built-in embedding model) ---
UPSTASH_VECTOR_REST_URL=https://...upstash.io
UPSTASH_VECTOR_REST_TOKEN=

# --- Notion (rolling audit page) ---
NOTION_API_KEY=secret_...
NOTION_AUDIT_PAGE_ID=

# --- Slack (P0 webhook) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Vercel cron auth ---
# Generate a random 32+ char string. Used as Bearer token to authenticate /api/audit.
CRON_SECRET=

# --- Optional knobs ---
MAX_CONCURRENT_LLM_CALLS=5
MAX_ARTICLES_PER_RUN=500
# Confidence floors. Issues below these are dropped.
CONFIDENCE_FLOOR_P0=0.6
CONFIDENCE_FLOOR_P1=0.6
CONFIDENCE_FLOOR_P2=0.7
