{
  "name": "delta-support-audit",
  "version": "0.1.0",
  "private": true,
  "description": "Daily audit of delta.exchange support content vs guides + docs sources of truth.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "embed-prompts": "tsx src/scripts/embed-prompts.ts",
    "prebuild": "tsx src/scripts/embed-prompts.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "crawl": "tsx src/scripts/crawl-once.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "dependencies": {
    "@notionhq/client": "^5.20.0",
    "@upstash/redis": "~1.34.0",
    "@upstash/vector": "^1.2.3",
    "cheerio": "~1.0.0",
    "domhandler": "^6.0.1",
    "dotenv": "~16.4.7",
    "next": "~15.1.0",
    "react": "~19.0.0",
    "react-dom": "~19.0.0",
    "zod": "~3.23.8"
  },
  "devDependencies": {
    "@types/node": "~20.17.0",
    "@types/react": "~19.0.0",
    "@types/react-dom": "~19.0.0",
    "eslint": "~9.17.0",
    "eslint-config-next": "~15.1.0",
    "prettier": "~3.4.2",
    "tsx": "~4.19.2",
    "typescript": "~5.7.2",
    "vitest": "~2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9"
}
